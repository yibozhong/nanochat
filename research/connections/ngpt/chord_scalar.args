--variant=baseline
--architecture=vanilla
--streams=1
--attention-kernel=original
--attention-backend=fa2
--residual-dynamics=ngpt_lookahead
--ngpt-velocity-mode=lookahead_split_learned_beta
--chord-velocity-geometry=ambient
--chord-kernel=current
--chord-state-dtype=bfloat16
--velocity-init=token
--velocity-embedding-std=0.02
--fuse-chord-read-norm
--no-recompute-chord-force
--lookahead-mu-init=0
--ngpt-alpha-init=0.05
--momentum-beta-init=0.5
--ngpt-force-rms-floor=1e-6
--chord-soft-force-tau=0.05
--chord-update-based
--chord-six-controls=static
--no-ngpt-weight-norm
--residual-projection-init=zero
--residual-projection-init-std=0.02
