# Run condor_submit from /home/yzhong239/mhc-nvidia-native after bundling the commit.
universe = vanilla
container_image = file:///staging/y/yzhong239/gradformer/nanochat-uv-v4.sif
executable = validate.sh
environment = "NANOCHAT_CONNECTION_ENTRYPOINT=scripts.connection_nvidia_native"
encrypt_input_files = /home/yzhong239/.netrc
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True
